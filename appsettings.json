{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Scanner": {
    "ResultsUrl": "https://screener.getvoroa.com/api/screener/results",
    "TimeoutSeconds": 30
  },
  "News": {
    "Enabled": true,
    "LookbackHours": 48,
    "MaxArticlesPerSymbol": 5,
    "Concurrency": 4,
    "TimeoutSeconds": 8
  },
  "OpenAI": {
    "Enabled": false,
    "Model": "gpt-6.2-astra",
    "ReasoningEffort": "high",
    "BaseUrl": "https://api.openai.com"
  },
  "Automation": {
    "Enabled": true,
    "MaxCandidates": 12,
    "MinPreliminaryScore": 60,
    "ExcludeMicroCap": true,
    "IntervalMinutes": 15
  },
  "PaperTrading": {
    "Enabled": true,
    "PaperMode": true,
    "MaxCapitalPerTrade": 20000,
    "MaxOpenPositions": 3
  }
}
